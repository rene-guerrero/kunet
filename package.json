{
  "name": "kunet",
  "private": true,
  "version": "0.1.0",
  "description": "Multiplayer plumbing for the Ku table games: room transports, local (Wi-Fi) hosting, client connection",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./native": "./src/native.ts",
    "./node": "./node/lan.mjs"
  },
  "sideEffects": false,
  "files": [
    "src",
    "node",
    "android/src",
    "android/build.gradle",
    "android/proguard-rules.pro"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "test:java": "node test/java/run.mjs"
  },
  "dependencies": {
    "qrcode-generator": "2.0.4",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@capacitor/core": "^8.6.2",
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  },
  "capacitor": {
    "android": {
      "src": "android"
    }
  },
  "peerDependencies": {
    "@capacitor/core": ">=7"
  },
  "peerDependenciesMeta": {
    "@capacitor/core": {
      "optional": true
    }
  }
}
